# 复制一份 .env 后填值；.env 已在 .gitignore 里
#
#   cp .env.example .env

# ---- 对外地址 ----
WXPUSH_BASE_URL=https://push.example.com

# 挂在子路径下才填（如 https://other.com/wxpush/...），独立域名留空
WXPUSH_PATH_PREFIX=

# ---- 登录 ----
# 公网部署必填；留空 = 谁都能管理
# WXPUSH_ADMIN_USER=admin
WXPUSH_ADMIN_PASSWORD=改成你自己的

# ---- 加密 ----
# 企业微信 Secret 与 webhook key 用 AES-256-GCM 落库。
# 留空 = 首次启动自动生成 data/secret.key（务必和数据一起备份）。
# 想固定密钥时生成：python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
# WXPUSH_ENCRYPTION_KEY=

# ---- 运行参数 ----
WXPUSH_MESSAGE_RETENTION_DAYS=180
WXPUSH_RATE_LIMIT_PER_MINUTE=120

# ---- 页脚 ----
# WXPUSH_FOOTER_HTML=<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">粤ICP备00000000号-1</a> · WXPUSH
